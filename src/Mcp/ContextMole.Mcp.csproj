<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Broker.Protocol\ContextMole.Broker.Protocol.csproj" />
    <ProjectReference Include="..\Core\ContextMole.Core.csproj" />
    <!-- Build ordering only: keeps local App.UI development launches broker-capable
         without copying the broker or any of its runtime dependency graph into this adapter. -->
    <ProjectReference Include="..\Broker\ContextMole.Broker.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\LICENSE"
             Link="LICENSE"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.md"
             Link="THIRD-PARTY-NOTICES.md"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD-PARTY-LICENSES\**\*"
             Link="THIRD-PARTY-LICENSES\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ContextMole.Mcp</AssemblyName>
    <RootNamespace>ContextMole.Mcp</RootNamespace>
    <AssemblyTitle>Context Mole MCP Server</AssemblyTitle>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <Target Name="PublishBundledBroker" AfterTargets="Publish"
          Condition="'$(RuntimeIdentifier)' != '' and '$(ContextMoleSkipBrokerBundle)' != 'true'">
    <PropertyGroup>
      <_BrokerBundleDirectory>$(PublishDir)broker\</_BrokerBundleDirectory>
    </PropertyGroup>
    <MSBuild Projects="..\Broker\ContextMole.Broker.csproj" Targets="Publish" BuildInParallel="false"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);Version=$(Version);SourceRevisionId=$(SourceRevisionId);ContinuousIntegrationBuild=$(ContinuousIntegrationBuild);PublishSingleFile=false;PublishTrimmed=false;PublishAot=false;PublishDir=$(_BrokerBundleDirectory);ContextMoleSkipBrokerBundle=true" />
  </Target>

</Project>
