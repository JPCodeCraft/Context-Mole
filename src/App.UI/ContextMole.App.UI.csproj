<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>ContextMole.App.UI</AssemblyName>
    <RootNamespace>ContextMole.App.UI</RootNamespace>
    <AssemblyTitle>Context Mole</AssemblyTitle>
    <Description>Private local document search for AI assistants.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\context-mole.ico</ApplicationIcon>
    <!-- Avalonia adds absolute AXAML paths after Roslyn applies PathMap. -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Include="..\..\docs\branding\context-mole\originals\context-mole-01-app-icon.png"
                       Link="Assets\context-mole-app-icon.png" />
    <Content Include="..\..\LICENSE"
             Link="LICENSE"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.md"
             Link="THIRD-PARTY-NOTICES.md"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD-PARTY-LICENSES\**\*"
             Link="THIRD-PARTY-LICENSES\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Broker.Protocol\ContextMole.Broker.Protocol.csproj" />
    <ProjectReference Include="..\Core\ContextMole.Core.csproj" />
    <ProjectReference Include="..\Indexing\ContextMole.Indexing.csproj" />
    <ProjectReference Include="..\Documents\ContextMole.Documents.csproj" />
    <ProjectReference Include="..\Storage\ContextMole.Storage.csproj" />
    <ProjectReference Include="..\Infrastructure\ContextMole.Infrastructure.csproj" />
    <ProjectReference Include="..\Mcp\ContextMole.Mcp.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <Target Name="PublishBundledMcpServer" AfterTargets="Publish"
          Condition="'$(RuntimeIdentifier)' != '' and '$(ContextMoleSkipMcpBundle)' != 'true'">
    <PropertyGroup>
      <_McpBundleDirectory>$(PublishDir)mcp-server\</_McpBundleDirectory>
    </PropertyGroup>
    <MSBuild Projects="..\Mcp\ContextMole.Mcp.csproj" Targets="Publish" BuildInParallel="false"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);Version=$(Version);SourceRevisionId=$(SourceRevisionId);ContinuousIntegrationBuild=$(ContinuousIntegrationBuild);PublishSingleFile=false;PublishTrimmed=false;PublishAot=false;PublishDir=$(_McpBundleDirectory);ContextMoleSkipMcpBundle=true" />
  </Target>

  <Target Name="PublishBundledUninstallHelper" AfterTargets="Publish"
          Condition="'$(RuntimeIdentifier)' == 'win-x64' and '$(ContextMoleSkipUninstallHelperBundle)' != 'true'">
    <PropertyGroup>
      <_UninstallHelperBundleDirectory>$(PublishDir)uninstall-helper\</_UninstallHelperBundleDirectory>
    </PropertyGroup>
    <MSBuild Projects="..\UninstallHelper\ContextMole.UninstallHelper.csproj" Targets="Publish" BuildInParallel="false"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);RuntimeIdentifier=win-x64;SelfContained=true;Version=$(Version);SourceRevisionId=$(SourceRevisionId);ContinuousIntegrationBuild=$(ContinuousIntegrationBuild);PublishSingleFile=true;EnableCompressionInSingleFile=true;PublishTrimmed=false;PublishReadyToRun=false;PublishAot=false;DebugType=None;PublishDir=$(_UninstallHelperBundleDirectory);ContextMoleSkipUninstallHelperBundle=true" />
  </Target>
</Project>
