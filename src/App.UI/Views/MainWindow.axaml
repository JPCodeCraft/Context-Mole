<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ContextMole.App.UI.ViewModels"
        xmlns:views="using:ContextMole.App.UI.Views"
        xmlns:controls="using:ContextMole.App.UI.Controls"
        x:Class="ContextMole.App.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1280" Height="800" MinWidth="980" MinHeight="640"
        Icon="/Assets/context-mole.ico"
        Title="Context Mole">
  <Grid ColumnDefinitions="240,*">
    <Border Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="16,18,16,14">
        <StackPanel Orientation="Horizontal" Spacing="11" Margin="6,0,6,20">
          <Image Width="36" Height="36" Source="/Assets/context-mole-app-icon.png"
                 Stretch="Uniform" />
          <StackPanel VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="Context Mole" FontWeight="SemiBold" FontSize="15" />
            <TextBlock Text="Search from your AI assistant" Classes="quiet" FontSize="12" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="5" HorizontalAlignment="Stretch">
          <Button Classes="navButton" Classes.active="{Binding IsProjectsSection}"
                  Content="Projects" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left" Click="ShowProjects"
                  AutomationProperties.Name="{Binding ProjectsNavigationAutomationName}" />
          <Button Classes="navButton" Classes.active="{Binding IsSettingsSection}"
                  Content="Settings" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left" Click="ShowSettings"
                  AutomationProperties.Name="{Binding SettingsNavigationAutomationName}" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="7,22,0,8">
          <TextBlock Text="Your projects" Classes="eyebrow" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="ghost sidebarAdd" Content="+" Click="AddProject"
                  IsEnabled="{Binding CanRunProjectAction}"
                  ToolTip.Tip="Add project" AutomationProperties.Name="Add project" />
        </Grid>

        <ListBox x:Name="ProjectList" Grid.Row="3" Classes="projectList" ItemsSource="{Binding Projects}"
                 SelectedItem="{Binding SelectedProject}" SelectionChanged="ProjectSelectionChanged"
                 AutomationProperties.Name="Projects">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ProjectItemViewModel">
              <Border Classes="projectCard" Classes.paused="{Binding IsPaused}"
                      Margin="0,0,0,4" Padding="10,9" CornerRadius="9" BorderThickness="1"
                      PointerPressed="ProjectCardPressed">
                <Border.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Move up" InputGesture="Ctrl+Shift+Up" Click="MoveProjectUp" />
                    <MenuItem Header="Move down" InputGesture="Ctrl+Shift+Down" Click="MoveProjectDown" />
                  </ContextMenu>
                </Border.ContextMenu>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <TextBlock Text="⠿" Classes="projectDragHandle" Cursor="SizeAll"
                             VerticalAlignment="Center" ToolTip.Tip="Drag to reorder. You can also right-click a project or press Ctrl+Shift+Up/Down."
                             PointerPressed="ProjectDragHandlePressed"
                             PointerMoved="ProjectDragHandleMoved"
                             PointerReleased="ProjectDragHandleReleased"
                             PointerCaptureLost="ProjectDragHandleCaptureLost" />
                  <StackPanel Grid.Column="1" Spacing="5">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Name}" AutomationProperties.Name="{Binding Name}" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7" ToolTip.Tip="{Binding PhaseDetails}">
                      <controls:StatusDot Tone="{Binding StatusTone}" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="{Binding SidebarStatus}" Classes="muted" FontSize="12"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock IsVisible="{Binding ShowSidebarIssueCount}" Text="{Binding SidebarErrorCountDisplay, StringFormat='· {0}'}"
                                   Foreground="{DynamicResource DangerBrush}" FontSize="12" />
                      </StackPanel>
                    </Grid>
                    <ProgressBar IsVisible="{Binding ShowProgress}" Minimum="0" Maximum="{Binding ProgressMaximum}" Value="{Binding ReadyCount}"
                                 IsIndeterminate="{Binding IsDiscovering}" ToolTip.Tip="{Binding ProgressDescription}"
                                 Height="3" Margin="0,2,0,0"
                                 AutomationProperties.Name="{Binding ProgressDescription}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="4" Spacing="10" Margin="3,12,3,0">
          <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="10,9">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
              <controls:StatusDot Tone="{Binding StatusTone}" VerticalAlignment="Top" Margin="0,4,0,0" />
              <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Classes="quiet" FontSize="12"
                         TextWrapping="Wrap" ToolTip.Tip="{Binding StatusDetails}"
                         AutomationProperties.HelpText="{Binding StatusDetails}" AutomationProperties.LiveSetting="Polite" />
            </Grid>
          </Border>
          <Button Classes="ghost compact" Content="Quit Context Mole" HorizontalContentAlignment="Left"
                  Click="QuitApplication" />
        </StackPanel>

        <Canvas x:Name="ProjectDragOverlay" Grid.RowSpan="5" ZIndex="100"
                IsHitTestVisible="False" ClipToBounds="False">
          <Border x:Name="ProjectDropSlot" Classes="projectDropSlot" IsVisible="False"
                  CornerRadius="9" BorderThickness="1" />
          <Border x:Name="ProjectDragGhost" Classes="projectDragGhost" IsVisible="False"
                  CornerRadius="9" BorderThickness="1">
            <Image x:Name="ProjectDragGhostImage" Stretch="Fill" />
          </Border>
        </Canvas>
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*">
      <Border Grid.Row="0" IsVisible="{Binding IsApplicationUpdateReady}"
              Background="{DynamicResource AccentSubtleBrush}" BorderBrush="#31568C"
              BorderThickness="0,0,0,1" Padding="30,10">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <TextBlock Text="{Binding ApplicationUpdateMessage}" Foreground="#BBD4FF"
                     TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="compact" Content="Open settings" Click="ShowSettings" />
        </Grid>
      </Border>

      <Border Grid.Row="1" IsVisible="{Binding HasStaleProjectData}"
              Background="{DynamicResource DangerSubtleBrush}" BorderBrush="{DynamicResource DangerBrush}"
              BorderThickness="0,0,0,1" Padding="30,14">
        <StackPanel Spacing="7">
          <TextBlock Text="Index status could not be refreshed" FontWeight="SemiBold" FontSize="15"
                     AutomationProperties.LiveSetting="Polite" />
          <TextBlock Text="{Binding LastProjectRefreshLabel}" TextWrapping="Wrap" />
          <SelectableTextBlock Text="{Binding ProjectLoadError}" TextWrapping="Wrap" FontSize="12" />
          <Button Content="Check index status again" Click="RetryProjectStatus" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>

      <Border Grid.Row="2" Classes="notificationBanner" Classes.error="{Binding IsNotificationError}" IsVisible="{Binding HasNotification}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="30,8">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <TextBlock Text="{Binding NotificationMessage}" TextWrapping="Wrap" VerticalAlignment="Center"
                     AutomationProperties.LiveSetting="Polite" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button IsVisible="{Binding NotificationCanOpenSettings}" Classes="compact" Content="Open settings" Click="ShowSettings" />
            <Button Classes="ghost compact" Content="Dismiss" Click="DismissNotification"
                    AutomationProperties.Name="Dismiss message" />
          </StackPanel>
        </Grid>
      </Border>
      <views:ProjectsView Grid.Row="3" IsVisible="{Binding IsProjectsSection}" />
      <views:SettingsView Grid.Row="3" IsVisible="{Binding IsSettingsSection}" />
    </Grid>
  </Grid>

  <Window.Styles>
    <Style Selector="Border.notificationBanner"><Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" /></Style>
    <Style Selector="Border.notificationBanner.error"><Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}" /></Style>
    <Style Selector="Button.sidebarAdd">
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Width" Value="26" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.navButton">
      <Setter Property="MinHeight" Value="41" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.navButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.navButton.active">
      <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
      <Setter Property="BorderBrush" Value="#2D4D7D" />
      <Setter Property="Foreground" Value="#C5D8FF" />
    </Style>
    <Style Selector="ListBox.projectList ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.projectList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.projectList ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.projectList ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.projectCard">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="TextBlock.projectDragHandle">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style Selector="TextBlock.projectDragHandle:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.projectDropSlot">
      <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Opacity" Value="0.48" />
    </Style>
    <Style Selector="Border.projectDragGhost">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BoxShadow" Value="0 12 30 0 #99000000" />
      <Setter Property="Opacity" Value="0.96" />
      <Setter Property="RenderTransform" Value="scale(1.02)" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    </Style>
    <Style Selector="ListBox.projectList ListBoxItem:pointerover Border.projectCard">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="ListBox.projectList ListBoxItem:selected Border.projectCard">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ListBox.projectList ListBoxItem Border.projectCard.paused">
      <Setter Property="Background" Value="{DynamicResource WarningSubtleBrush}" />
      <Setter Property="BorderBrush" Value="#5B4925" />
    </Style>
    <Style Selector="ListBox.projectList ListBoxItem:pointerover Border.projectCard.paused">
      <Setter Property="Background" Value="#342B1A" />
      <Setter Property="BorderBrush" Value="#735D2E" />
    </Style>
    <Style Selector="ListBox.projectList ListBoxItem:selected Border.projectCard.paused">
      <Setter Property="Background" Value="#342B1A" />
      <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
    </Style>
    <Style Selector="ProgressBar.paused">
      <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
    </Style>
  </Window.Styles>
</Window>
