<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ContextMole.App.UI.ViewModels"
        xmlns:views="using:ContextMole.App.UI.Views"
        x:Class="ContextMole.App.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1280" Height="800" MinWidth="980" MinHeight="640"
        Icon="/Assets/context-mole.ico"
        Title="Context Mole">
  <Grid ColumnDefinitions="268,*">
    <Border Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="16,18,16,14">
        <StackPanel Orientation="Horizontal" Spacing="11" Margin="6,0,6,20">
          <Image Width="36" Height="36" Source="/Assets/context-mole-app-icon.png"
                 Stretch="Uniform" />
          <StackPanel VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="Context Mole" FontWeight="SemiBold" FontSize="15" />
            <TextBlock Text="Local document search" Classes="quiet" FontSize="11" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="5" HorizontalAlignment="Stretch">
          <Button Classes="navButton" Classes.active="{Binding IsProjectsSection}"
                  Content="Projects" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left" Click="ShowProjects"
                  AutomationProperties.Name="{Binding ProjectsNavigationAutomationName}" />
          <Button Classes="navButton" Classes.active="{Binding IsSettingsSection}"
                  Content="Settings" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left" Click="ShowSettings"
                  AutomationProperties.Name="{Binding SettingsNavigationAutomationName}" />
        </StackPanel>

        <TextBlock Grid.Row="2" Text="YOUR PROJECTS" Classes="eyebrow"
                   Margin="7,25,5,11" VerticalAlignment="Center" />

        <ListBox x:Name="ProjectList" Grid.Row="3" Classes="projectList" ItemsSource="{Binding Projects}"
                 SelectedItem="{Binding SelectedProject}" SelectionChanged="ProjectSelectionChanged"
                 AutomationProperties.Name="Projects">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ProjectItemViewModel">
              <Border Classes="projectCard" Classes.paused="{Binding IsPaused}"
                      Margin="0,0,0,7" Padding="12" CornerRadius="9" BorderThickness="1"
                      PointerPressed="ProjectCardPressed">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <TextBlock Text="⠿" Classes="projectDragHandle" Cursor="SizeAll"
                             VerticalAlignment="Center" ToolTip.Tip="Drag to reorder"
                             PointerPressed="ProjectDragHandlePressed"
                             PointerMoved="ProjectDragHandleMoved"
                             PointerReleased="ProjectDragHandleReleased"
                             PointerCaptureLost="ProjectDragHandleCaptureLost" />
                  <StackPanel Grid.Column="1" Spacing="7">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding Name}" />
                      <Border Grid.Column="1" Classes="phaseBadge" Classes.paused="{Binding IsPaused}"
                              Classes.ready="{Binding IsReady}" Classes.retrying="{Binding IsRetrying}"
                              Classes.attention="{Binding NeedsAttention}"
                              Padding="7,2" CornerRadius="8">
                        <TextBlock Text="{Binding Phase}" Classes="phaseText"
                                   Classes.paused="{Binding IsPaused}" Classes.ready="{Binding IsReady}"
                                   Classes.retrying="{Binding IsRetrying}" Classes.attention="{Binding NeedsAttention}"
                                   FontSize="10" FontWeight="SemiBold" />
                      </Border>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <TextBlock Text="{Binding DocumentCountDisplay}" Classes="muted" FontSize="11" />
                      <StackPanel IsVisible="{Binding HasErrors}" Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="·" Classes="quiet" FontSize="11" />
                        <TextBlock Text="{Binding SidebarErrorCountDisplay}" Foreground="{DynamicResource DangerBrush}"
                                   FontSize="11" />
                      </StackPanel>
                    </StackPanel>
                    <ProgressBar Minimum="0" Maximum="{Binding DocumentCount}" Value="{Binding IndexedCount}"
                                 Classes.paused="{Binding IsPaused}" Height="4"
                                 AutomationProperties.Name="Project indexing progress" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="4" Spacing="10" Margin="3,12,3,0">
          <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="10,9">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
              <Border Width="7" Height="7" CornerRadius="4" Background="{DynamicResource BorderStrongBrush}"
                      VerticalAlignment="Top" Margin="0,4,0,0" />
              <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Classes="quiet" FontSize="11"
                         TextWrapping="Wrap" MaxHeight="48" AutomationProperties.LiveSetting="Polite" />
            </Grid>
          </Border>
          <Button Classes="ghost compact" Content="Quit Context Mole" HorizontalContentAlignment="Left"
                  Click="QuitApplication" />
        </StackPanel>

        <Canvas x:Name="ProjectDragOverlay" Grid.RowSpan="5" ZIndex="100"
                IsHitTestVisible="False" ClipToBounds="False">
          <Border x:Name="ProjectDropSlot" Classes="projectDropSlot" IsVisible="False"
                  CornerRadius="9" BorderThickness="1" />
          <Border x:Name="ProjectDragGhost" Classes="projectDragGhost" IsVisible="False"
                  CornerRadius="9" BorderThickness="1">
            <Image x:Name="ProjectDragGhostImage" Stretch="Fill" />
          </Border>
        </Canvas>
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">
      <Border Grid.Row="0" Background="{DynamicResource AppBackgroundBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="30,21">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
          <StackPanel IsVisible="{Binding IsProjectsSection}" Spacing="3">
            <TextBlock Text="Projects" Classes="pageTitle" />
            <TextBlock Text="Monitor and manage your local indexes." Classes="muted" />
          </StackPanel>
          <StackPanel IsVisible="{Binding IsSettingsSection}" Spacing="3">
            <TextBlock Text="Settings" Classes="pageTitle" />
            <TextBlock Text="Preferences apply globally across every project." Classes="muted" />
          </StackPanel>
          <Button Grid.Column="1" IsVisible="{Binding IsProjectsSection}" Classes="primary"
                  Content="Add project" Click="AddProject" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <Border Grid.Row="1" IsVisible="{Binding IsApplicationUpdateReady}"
              Background="{DynamicResource AccentSubtleBrush}" BorderBrush="#31568C"
              BorderThickness="0,0,0,1" Padding="30,10">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <TextBlock Text="{Binding ApplicationUpdateMessage}" Foreground="#BBD4FF"
                     TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="compact" Content="Open settings" Click="ShowSettings" />
        </Grid>
      </Border>

      <views:ProjectsView Grid.Row="2" IsVisible="{Binding IsProjectsSection}" />
      <views:SettingsView Grid.Row="2" IsVisible="{Binding IsSettingsSection}" />
    </Grid>
  </Grid>

  <Window.Styles>
    <Style Selector="Button.navButton">
      <Setter Property="MinHeight" Value="41" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.navButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.navButton.active">
      <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
      <Setter Property="BorderBrush" Value="#2D4D7D" />
      <Setter Property="Foreground" Value="#C5D8FF" />
    </Style>
    <Style Selector="ListBox.projectList ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.projectList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.projectList ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.projectList ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.projectCard">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="TextBlock.projectDragHandle">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style Selector="TextBlock.projectDragHandle:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.projectDropSlot">
      <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Opacity" Value="0.48" />
    </Style>
    <Style Selector="Border.projectDragGhost">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BoxShadow" Value="0 12 30 0 #99000000" />
      <Setter Property="Opacity" Value="0.96" />
      <Setter Property="RenderTransform" Value="scale(1.02)" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    </Style>
    <Style Selector="ListBox.projectList ListBoxItem:pointerover Border.projectCard">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="ListBox.projectList ListBoxItem:selected Border.projectCard">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ListBox.projectList ListBoxItem Border.projectCard.paused">
      <Setter Property="Background" Value="{DynamicResource WarningSubtleBrush}" />
      <Setter Property="BorderBrush" Value="#5B4925" />
    </Style>
    <Style Selector="ListBox.projectList ListBoxItem:pointerover Border.projectCard.paused">
      <Setter Property="Background" Value="#342B1A" />
      <Setter Property="BorderBrush" Value="#735D2E" />
    </Style>
    <Style Selector="ListBox.projectList ListBoxItem:selected Border.projectCard.paused">
      <Setter Property="Background" Value="#342B1A" />
      <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
    </Style>
    <Style Selector="ProgressBar.paused">
      <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
    </Style>
  </Window.Styles>
</Window>
