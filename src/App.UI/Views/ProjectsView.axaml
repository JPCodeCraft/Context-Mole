<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ContextMole.App.UI.ViewModels"
             xmlns:core="using:ContextMole.Core"
             xmlns:controls="using:ContextMole.App.UI.Controls"
             x:Class="ContextMole.App.UI.Views.ProjectsView"
             x:DataType="vm:MainViewModel">
  <Grid RowDefinitions="Auto,*">
    <!-- The project header stays in place while the details scroll. -->
    <Border Grid.Row="0" IsVisible="{Binding HasSelection}" Classes="pageHeader">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20" MaxWidth="1120">
        <StackPanel Spacing="5" VerticalAlignment="Center">
          <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="12" HorizontalAlignment="Left">
            <TextBlock Text="{Binding SelectedProject.Name}" Classes="pageTitle" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding SelectedProject.Name}" />
            <controls:StatusBadge Grid.Column="1" Text="{Binding SelectedProject.Phase}" Tone="{Binding SelectedProject.StatusTone}"
                                  ToolTip.Tip="{Binding SelectedProject.PhaseDetails}" Margin="0,4,0,0"
                                  AutomationProperties.Name="Project status" />
          </Grid>
          <TextBlock Text="{Binding SelectedProject.ProjectDetailsDisplay}" Classes="muted" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                    IsEnabled="{Binding SelectedProject.AreActionsEnabled}">
          <Button Content="{Binding SelectedProject.PauseActionLabel}" Click="TogglePause" />
          <Button Content="Edit" Click="EditProject" ToolTip.Tip="Rename the project or change its folders." />
          <Button Content="More" AutomationProperties.Name="More project actions">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="Reindex project…" Click="ReindexProject" IsEnabled="{Binding SelectedProject.CanReindex}"
                          ToolTip.Tip="{Binding SelectedProject.ReindexToolTip}" />
                <Separator />
                <MenuItem Header="Remove project…" Classes="danger" Click="RemoveProject"
                          ToolTip.Tip="Delete this project's local index. Original files stay untouched." />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1">
      <StackPanel Classes="pageContent">
        <Border IsVisible="{Binding IsProjectLoadPending}" Classes="card" MinHeight="150">
          <StackPanel Spacing="12">
            <TextBlock Text="Loading your projects…" Classes="sectionTitle" AutomationProperties.LiveSetting="Polite" />
            <ProgressBar IsIndeterminate="True" Height="5" AutomationProperties.Name="Loading project status" />
          </StackPanel>
        </Border>
        <Border IsVisible="{Binding HasInitialProjectLoadError}" Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Text="Projects could not be loaded" Classes="sectionTitle" />
            <TextBlock Text="{Binding ProjectLoadError}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
            <Button Content="Try again" Click="ReloadProjects" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>
        <Border IsVisible="{Binding IsProjectActionBusy}" Classes="row">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding ProjectActionMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <ProgressBar IsIndeterminate="True" Height="3" AutomationProperties.Name="Project action in progress" />
          </StackPanel>
        </Border>

        <!-- First run: what the app does, in three steps, and the two ways to start. -->
        <Border IsVisible="{Binding HasNoSelection}" Classes="card" Padding="36,34">
          <StackPanel Spacing="26" MaxWidth="760" HorizontalAlignment="Center">
            <StackPanel Spacing="7">
              <TextBlock Text="Let your AI assistant search your files" Classes="pageTitle" HorizontalAlignment="Center"
                         TextAlignment="Center" TextWrapping="Wrap" />
              <TextBlock Text="Context Mole builds a private search index on this PC. Your assistant uses it to find the right passages in large folders."
                         Classes="muted" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
            </StackPanel>
            <UniformGrid Columns="3">
              <Border Classes="stepCard" Margin="0,0,10,0">
                <StackPanel Spacing="8">
                  <Border Classes="stepNumber"><TextBlock Text="1" /></Border>
                  <TextBlock Text="Add a project" Classes="cardTitle" />
                  <TextBlock Text="Pick one or more folders with the documents you want to search." Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Classes="stepCard" Margin="5,0,5,0">
                <StackPanel Spacing="8">
                  <Border Classes="stepNumber"><TextBlock Text="2" /></Border>
                  <TextBlock Text="Context Mole indexes it" Classes="cardTitle" />
                  <TextBlock Text="Documents, PDFs, email and scanned pages are read on this PC. Folders are watched for changes." Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Classes="stepCard" Margin="10,0,0,0">
                <StackPanel Spacing="8">
                  <Border Classes="stepNumber"><TextBlock Text="3" /></Border>
                  <TextBlock Text="Ask your assistant" Classes="cardTitle" />
                  <TextBlock Text="Connect Claude, Codex or another assistant, then ask it about your files." Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </UniformGrid>
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
              <Button Classes="primary" Content="Add your first project" Click="AddProject" IsEnabled="{Binding CanRunProjectAction}" />
              <Button Content="Connect an assistant" Click="ShowAiConnections" />
            </StackPanel>
          </StackPanel>
        </Border>

        <StackPanel IsVisible="{Binding HasSelection}" Spacing="16">
          <!-- 1. How is my data? One headline, one sentence, one bar. -->
          <Border Classes="card" AutomationProperties.Name="Project status">
            <StackPanel Spacing="14">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding SelectedProject.StatusHeadline}" Classes="statusHeadline" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="{Binding SelectedProject.StatusSummary}" Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
              <controls:SegmentBar Ready="{Binding SelectedProject.ReadyCount}" Processing="{Binding SelectedProject.ProcessingCount}"
                                   Queued="{Binding SelectedProject.QueuedCount}" Attention="{Binding SelectedProject.AttentionCount}"
                                   ToolTip.Tip="{Binding SelectedProject.ProgressDescription}"
                                   AutomationProperties.Name="{Binding SelectedProject.ProgressDescription}" />
              <WrapPanel Orientation="Horizontal">
                <StackPanel Classes="legend">
                  <Border Classes="legendSwatch ready" />
                  <TextBlock Text="{Binding SelectedProject.ReadyLegend}" Classes="muted" FontSize="13" />
                </StackPanel>
                <StackPanel Classes="legend" IsVisible="{Binding SelectedProject.HasProcessingFiles}">
                  <Border Classes="legendSwatch processing" />
                  <TextBlock Text="{Binding SelectedProject.ProcessingLegend}" Classes="muted" FontSize="13" />
                </StackPanel>
                <StackPanel Classes="legend" IsVisible="{Binding SelectedProject.HasQueuedFiles}"
                            ToolTip.Tip="{Binding SelectedProject.QueuedBreakdownDisplay}">
                  <Border Classes="legendSwatch queued" />
                  <TextBlock Text="{Binding SelectedProject.QueuedLegend}" Classes="muted" FontSize="13" />
                </StackPanel>
                <StackPanel Classes="legend" IsVisible="{Binding SelectedProject.HasAttentionFiles}">
                  <Border Classes="legendSwatch attention" />
                  <TextBlock Text="{Binding SelectedProject.AttentionLegend}" Classes="muted" FontSize="13" />
                </StackPanel>
              </WrapPanel>
              <Border Classes="divider" />
              <!-- A single line of fixed height: the active file or the last update. -->
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinHeight="28">
                <TextBlock IsVisible="{Binding HasActiveIndexingItems}" Text="{Binding IndexingNowDisplay}"
                           Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           ToolTip.Tip="{Binding IndexingNowDisplay}" />
                <TextBlock IsVisible="{Binding HasNoActiveIndexingItems}" Text="{Binding SelectedProject.IdleActivityDisplay}"
                           Classes="quiet" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <ToggleButton Grid.Column="1" Classes="linkToggle" IsChecked="{Binding IsActiveIndexingExpanded, Mode=TwoWay}"
                              AutomationProperties.Name="Show or hide indexing details">
                  <Panel>
                    <TextBlock Text="Show details" IsVisible="{Binding IsActiveIndexingCollapsed}" />
                    <TextBlock Text="Hide details" IsVisible="{Binding IsActiveIndexingExpanded}" />
                  </Panel>
                </ToggleButton>
              </Grid>
              <StackPanel IsVisible="{Binding IsActiveIndexingExpanded}" Spacing="8">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                  <controls:StatusBadge Text="{Binding IndexingActivityStatusLabel}" />
                  <TextBlock Grid.Column="1" Text="{Binding IndexingTimingSummary}" Classes="quiet" FontSize="12"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding IndexingLastCompletionDisplay}" />
                </Grid>
                <!-- The list keeps one height while open so workers starting and finishing never move the page. -->
                <Grid Height="172">
                  <TextBlock IsVisible="{Binding HasNoActiveIndexingItems}" Text="{Binding IndexingIdleMessage}"
                             Classes="quiet" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center"
                             TextAlignment="Center" MaxWidth="560" />
                  <ScrollViewer IsVisible="{Binding HasActiveIndexingItems}"
                                HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ActiveIndexingItems}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:IndexingActivityItemViewModel">
                          <Border Classes="row" Margin="0,0,0,6" Padding="12,9">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="3">
                              <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                         ToolTip.Tip="{Binding SourcePath}" />
                              <TextBlock Grid.Column="1" Text="{Binding StageElapsedDisplay}" Classes="quiet" FontSize="12"
                                         IsVisible="{Binding ShowTimers}" ToolTip.Tip="{Binding ElapsedDisplay}" />
                              <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding StageDisplay}"
                                         Foreground="{DynamicResource AccentBrush}" FontSize="12" />
                              <ProgressBar Grid.Row="2" Grid.ColumnSpan="2" Height="3" Margin="0,4,0,0"
                                           IsIndeterminate="{Binding IsProgressIndeterminate}"
                                           AutomationProperties.Name="File indexing activity; completion time is unknown" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- 2. Can my assistant use it? -->
          <Border Classes="card" AutomationProperties.Name="Search with your AI assistant">
            <StackPanel Spacing="16">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="3">
                  <TextBlock Text="Search with your AI assistant" Classes="sectionTitle" />
                  <TextBlock Text="Indexing and search run on this PC. Your assistant reads the passages it finds and may send them to its provider."
                             Classes="quiet" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="Copy starter question" Click="CopyStarterPrompt" VerticalAlignment="Top"
                        ToolTip.Tip="Copy a question to paste into your assistant to try this project." />
              </Grid>
              <Grid ColumnDefinitions="180,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="14">
                <TextBlock Text="Keyword search" Classes="fieldLabel" VerticalAlignment="Top" Margin="0,3,0,0" />
                <StackPanel Grid.Column="1" Spacing="4">
                  <controls:StatusBadge Text="{Binding SelectedProject.KeywordSearchLabel}" Tone="{Binding SelectedProject.KeywordSearchTone}" />
                  <TextBlock Text="{Binding SelectedProject.KeywordSearchMessage}" Classes="muted" FontSize="13" TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock Grid.Row="1" Text="Meaning-based search" Classes="fieldLabel" VerticalAlignment="Top" Margin="0,3,0,0" />
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                  <controls:StatusBadge Text="{Binding SelectedProject.SemanticIndexStatusLabel}" Tone="{Binding SelectedProject.SemanticIndexStatusTone}" />
                  <TextBlock Text="{Binding SelectedProject.SemanticIndexStatusMessage}" Classes="muted" FontSize="13" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Top">
                  <Button Content="Complete coverage" Click="RepairSemanticIndex" IsVisible="{Binding SelectedProject.ShowSemanticRepairButton}"
                          IsEnabled="{Binding SelectedProject.CanRepairSemanticIndex}" ToolTip.Tip="{Binding SelectedProject.RepairSemanticIndexToolTip}" />
                  <Button Content="Turn on" Click="ShowSettings" IsVisible="{Binding SelectedProject.IsSemanticSetupNeeded}"
                          ToolTip.Tip="Set up meaning-based search in Settings." />
                </StackPanel>

                <TextBlock Grid.Row="2" Text="Assistants" Classes="fieldLabel" VerticalAlignment="Top" Margin="0,3,0,0" />
                <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                  <controls:StatusBadge Text="{Binding AiConnectionsStatusLabel}" Tone="{Binding AiConnectionsStatusTone}" />
                  <TextBlock Text="{Binding ConnectedAssistantsSummary}" Classes="muted" FontSize="13" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" VerticalAlignment="Top">
                  <Button Content="Manage" Click="ShowAiConnections" IsVisible="{Binding HasConnectedAssistants}" />
                  <Button Classes="primary" Content="Connect an assistant" Click="ShowAiConnections" IsVisible="{Binding !HasConnectedAssistants}" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- 3. What needs my attention? -->
          <Border Classes="card issuesCard" IsVisible="{Binding SelectedProject.HasIssueCard}">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="3">
                  <TextBlock Text="Files that need attention" Classes="sectionTitle" />
                  <TextBlock Text="{Binding SelectedProject.GroupedIssuesSummary}" Classes="quiet" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="Retry all" Click="RetryFailedFiles" VerticalAlignment="Top"
                        IsEnabled="{Binding SelectedProject.CanRetryFailedFiles}"
                        ToolTip.Tip="Queue every file with a current issue again, including hidden issues and other pages." />
              </Grid>
              <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                <TextBox Text="{Binding SelectedProject.IssueQuery, Mode=TwoWay}" MaxLength="500" TextChanged="IssueFiltersChanged"
                         PlaceholderText="Search by file name, folder or problem"
                         AutomationProperties.Name="Search files that need attention" />
                <ComboBox Grid.Column="1" SelectedIndex="{Binding SelectedProject.IssueImpactFilterIndex, Mode=TwoWay}"
                          SelectionChanged="IssueImpactChanged" MinWidth="190" AutomationProperties.Name="Filter by what is missing from search">
                  <ComboBoxItem Content="All problems" />
                  <ComboBoxItem Content="Not searchable" />
                  <ComboBoxItem Content="Partly searchable" />
                  <ComboBoxItem Content="Older version searchable" />
                </ComboBox>
                <ToggleButton Grid.Column="2" Content="{Binding SelectedProject.HiddenIssuesDisplay}"
                              IsChecked="{Binding SelectedProject.ShowHiddenIssues, Mode=TwoWay}" Click="ShowHiddenIssues"
                              IsVisible="{Binding SelectedProject.HasHiddenIssues}" AutomationProperties.Name="Show or hide hidden issues" />
                <Button Grid.Column="3" Content="Restore all" Click="RestoreAllIssues" IsVisible="{Binding SelectedProject.HasHiddenIssues}"
                        IsEnabled="{Binding SelectedProject.AreActionsEnabled}" ToolTip.Tip="Show every hidden issue in this list again." />
              </Grid>
              <Border IsVisible="{Binding SelectedProject.IssuesChangedDuringPaging}" Classes="row">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <TextBlock Text="This list changed while you were browsing. New or changed files may be on an earlier page."
                             Classes="muted" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                  <Button Grid.Column="1" Classes="compact" Content="Back to first page" Click="RefreshIssuesFromStart" />
                </Grid>
              </Border>
              <Border IsVisible="{Binding SelectedProject.HasIssueLoadError}" Classes="row">
                <StackPanel Spacing="6">
                  <TextBlock Text="This list could not be loaded" FontWeight="SemiBold" />
                  <SelectableTextBlock Text="{Binding SelectedProject.IssueLoadError}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                  <Button Classes="compact" Content="Try again" Click="RefreshIssues" HorizontalAlignment="Left" />
                </StackPanel>
              </Border>
              <TextBlock IsVisible="{Binding SelectedProject.HasNoMatchingIssueGroups}" Text="{Binding SelectedProject.NoMatchingIssuesMessage}"
                         Classes="muted" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding SelectedProject.IssueGroups}" IsEnabled="{Binding CanRunProjectAction}"
                            AutomationProperties.Name="Files that need attention">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProjectIssueGroupViewModel">
                    <Border Classes="row" Margin="0,0,0,8">
                      <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                          <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                     ToolTip.Tip="{Binding SourcePath}" VerticalAlignment="Center" />
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <controls:StatusBadge Text="{Binding ImpactLabel}" Tone="{Binding ImpactTone}" ToolTip.Tip="{Binding ImpactMessage}" />
                            <controls:StatusBadge Text="{Binding RetryLabel}" Tone="{Binding RetryTone}" ToolTip.Tip="{Binding RetryMessage}" />
                          </StackPanel>
                        </Grid>
                        <SelectableTextBlock Text="{Binding SourcePath}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                                             TextWrapping="Wrap" AutomationProperties.Name="Original file path, selectable and copyable" />
                        <TextBlock Text="{Binding RecoveryGuidance}" Classes="muted" FontSize="13" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,4,0,0">
                          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                            <Button Classes="compact" Content="Retry" Click="RetryIssueFile" IsEnabled="{Binding CanRetry}"
                                    ToolTip.Tip="Index this file again now." />
                            <Button Classes="compact" Content="Hide" Click="HideIssueFile" IsVisible="{Binding CanHide}"
                                    ToolTip.Tip="Remove this file from the list. The issue is not fixed and search is unchanged." />
                            <Button Classes="compact" Content="Unhide" Click="RestoreIssueFile" IsVisible="{Binding HasHiddenIssues}" />
                            <Button Classes="compact ghost danger" Content="Exclude…" Click="ExcludeIssueFile" IsVisible="{Binding IsRootFile}"
                                    ToolTip.Tip="Stop indexing this file and remove it from search. The original file is untouched." />
                          </StackPanel>
                          <Expander Grid.Column="1" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch" Padding="0" Margin="0,-6,0,0" MinHeight="0">
                            <Expander.Header>
                              <TextBlock Text="{Binding IssueCountDisplay, StringFormat='Details · {0}'}" Classes="quiet" FontSize="12" />
                            </Expander.Header>
                            <StackPanel Spacing="6" Margin="0,6,0,0">
                              <TextBlock IsVisible="{Binding DetailsWereRefreshed}" Text="These details changed and were reloaded from the first page."
                                         Classes="quiet" FontSize="12" TextWrapping="Wrap" />
                              <ItemsControl ItemsSource="{Binding Details}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:ProjectIssueDetailViewModel">
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,2">
                                      <StackPanel Spacing="3">
                                        <SelectableTextBlock Text="{Binding ComponentName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <SelectableTextBlock Text="{Binding Message}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                        <SelectableTextBlock Text="{Binding ComponentKey}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap"
                                                             AutomationProperties.Name="Exact attachment, page or component location" />
                                        <SelectableTextBlock Text="{Binding CodeAndAttempt}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding CreatedDisplay}" Classes="quiet" FontSize="12" TextWrapping="Wrap" />
                                      </StackPanel>
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" IsVisible="{Binding HasDetailPages}">
                                <TextBlock Text="{Binding DetailsPageDisplay}" Classes="quiet" FontSize="12" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="compact" Content="Previous" Click="PreviousIssueDetails" IsEnabled="{Binding CanPreviousDetails}" />
                                <Button Grid.Column="2" Classes="compact" Content="Next" Click="NextIssueDetails" IsEnabled="{Binding CanNextDetails}" />
                              </Grid>
                            </StackPanel>
                          </Expander>
                        </Grid>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding SelectedProject.HasIssuePages}">
                <TextBlock Text="{Binding SelectedProject.IssuePageDisplay}" Classes="quiet" FontSize="12" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="compact" Content="Previous" Click="PreviousIssuePage" IsEnabled="{Binding SelectedProject.CanPreviousIssuePage}"
                        AutomationProperties.Name="Previous page of files that need attention" />
                <Button Grid.Column="2" Classes="compact" Content="Next" Click="NextIssuePage" IsEnabled="{Binding SelectedProject.CanNextIssuePage}"
                        AutomationProperties.Name="Next page of files that need attention" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Classes="row" IsVisible="{Binding SelectedProject.HasIssueActionMessage}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBlock Text="{Binding SelectedProject.IssueActionMessage}" TextWrapping="Wrap" VerticalAlignment="Center"
                         AutomationProperties.LiveSetting="Polite" />
              <Button Grid.Column="1" Classes="compact" Content="Undo" Click="UndoIssueHide" IsVisible="{Binding SelectedProject.HasUndoIssueHide}"
                      IsEnabled="{Binding SelectedProject.AreActionsEnabled}" AutomationProperties.Name="Undo last hide" />
            </Grid>
          </Border>

          <!-- 4. What is in this project? -->
          <Border Classes="card" AutomationProperties.Name="Folders and file types">
            <StackPanel Spacing="16">
              <StackPanel Spacing="3">
                <TextBlock Text="Folders and file types" Classes="sectionTitle" />
                <TextBlock Text="Folders are watched for new, changed and removed files." Classes="quiet" FontSize="12" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding SelectedProject.FolderRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProjectFolderRow">
                    <Border Classes="row" Margin="0,0,0,6" Padding="12,10">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                        <controls:StatusDot Tone="{Binding Tone}" VerticalAlignment="Top" Margin="0,6,0,0" />
                        <StackPanel Grid.Column="1" Spacing="2">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <SelectableTextBlock Text="{Binding Path}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap"
                                               AutomationProperties.Name="Watched folder path, selectable and copyable" />
                          <TextBlock IsVisible="{Binding HasIssue}" Text="{Binding Issue}" Foreground="{DynamicResource DangerBrush}"
                                     FontSize="13" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Spacing="8">
                <TextBlock Text="File types found" Classes="fieldLabel" />
                <TextBlock IsVisible="{Binding SelectedProject.HasNoFileTypeCounts}" Text="No supported files have been counted yet."
                           Classes="muted" TextWrapping="Wrap" />
                <ItemsControl IsVisible="{Binding SelectedProject.HasFileTypeCounts}" ItemsSource="{Binding SelectedProject.FileTypeCounts}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="core:ProjectFileTypeCount">
                      <Border Classes="fileTypeChip" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                          <TextBlock Text="{Binding Extension}" FontWeight="SemiBold" Foreground="#C7D7F3" />
                          <TextBlock Text="{Binding Count, StringFormat={}{0:N0}}" Classes="muted" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <Expander IsVisible="{Binding SelectedProject.HasExcludedFiles}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Header="{Binding SelectedProject.ExcludedFilesSummary}">
                <StackPanel Spacing="8">
                  <TextBlock Text="These files are left out of indexing and search. A file that is renamed or moved is indexed again."
                             Classes="quiet" FontSize="12" TextWrapping="Wrap" />
                  <TextBox Text="{Binding SelectedProject.ExcludedQuery, Mode=TwoWay}" MaxLength="500" PlaceholderText="Find an excluded file"
                           AutomationProperties.Name="Search excluded files" />
                  <TextBlock IsVisible="{Binding SelectedProject.HasNoMatchingExcludedFiles}" Text="No excluded files match this search." Classes="muted" />
                  <ItemsControl ItemsSource="{Binding SelectedProject.ExcludedFiles}" IsEnabled="{Binding CanRunProjectAction}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ExcludedFileItemViewModel">
                        <Border Classes="row" Margin="0,0,0,6" Padding="12,10">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="3">
                              <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                              <SelectableTextBlock Text="{Binding SourcePath}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" />
                              <TextBlock Text="{Binding ScopeDisplay}" Classes="quiet" FontSize="12" TextWrapping="Wrap" ToolTip.Tip="{Binding ExcludedDisplay}" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="compact" Content="Include again" Click="IncludeIssueFile" VerticalAlignment="Top" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding SelectedProject.HasExcludedPages}">
                    <TextBlock Text="{Binding SelectedProject.ExcludedPageDisplay}" Classes="quiet" FontSize="12" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="compact" Content="Previous" Click="PreviousExcludedPage" IsEnabled="{Binding SelectedProject.CanPreviousExcludedPage}" />
                    <Button Grid.Column="2" Classes="compact" Content="Next" Click="NextExcludedPage" IsEnabled="{Binding SelectedProject.CanNextExcludedPage}" />
                  </Grid>
                </StackPanel>
              </Expander>
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>

  <UserControl.Styles>
    <Style Selector="Border.pageHeader">
      <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="30,20" />
    </Style>
    <Style Selector="StackPanel.legend">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="7" />
      <Setter Property="Margin" Value="0,0,20,4" />
    </Style>
    <Style Selector="ToggleButton.linkToggle">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.linkToggle:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="MenuItem.danger">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="Border.stepCard">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="Border.stepNumber">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
    </Style>
    <Style Selector="Border.stepNumber > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.fileTypeChip">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
  </UserControl.Styles>
</UserControl>
