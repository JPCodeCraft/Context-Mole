<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ContextMole.App.UI.ViewModels"
             xmlns:core="using:ContextMole.Core"
             xmlns:indexing="using:ContextMole.Indexing"
             x:Class="ContextMole.App.UI.Views.ProjectsView"
             x:DataType="vm:MainViewModel">
  <ScrollViewer>
    <StackPanel Classes="pageContent">
      <Border IsVisible="{Binding IsProjectLoadPending}" Classes="card" MinHeight="150">
        <StackPanel Spacing="12">
          <TextBlock Text="Loading local projects…" Classes="sectionTitle" AutomationProperties.LiveSetting="Polite" />
          <ProgressBar IsIndeterminate="True" Height="5" AutomationProperties.Name="Loading project status" />
        </StackPanel>
      </Border>
      <Border IsVisible="{Binding HasInitialProjectLoadError}" Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="Projects could not be loaded" Classes="sectionTitle" />
          <TextBlock Text="{Binding ProjectLoadError}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
          <Button Content="Try again" Click="ReloadProjects" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>
      <Border IsVisible="{Binding IsProjectActionBusy}" Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding ProjectActionMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
          <ProgressBar IsIndeterminate="True" Height="4" AutomationProperties.Name="Project action in progress" />
        </StackPanel>
      </Border>
      <Border IsVisible="{Binding HasNoSelection}" Classes="card" MinHeight="260">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="9" MaxWidth="420">
          <Button Width="48" Height="48" Classes="addProjectButton" Click="AddProject"
                  IsEnabled="{Binding CanRunProjectAction}"
                  HorizontalAlignment="Center"
                  ToolTip.Tip="Add project" AutomationProperties.Name="Add project">
            <TextBlock Text="+" Foreground="{DynamicResource AccentBrush}" FontSize="27"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
          <TextBlock Text="Create your first project" Classes="sectionTitle" HorizontalAlignment="Center" />
          <TextBlock Text="Choose one or more folders and Context Mole will build a private, local search index."
                     Classes="muted" TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>
      </Border>

      <ContentControl Content="{Binding SelectedProject}" HorizontalContentAlignment="Stretch">
        <ContentControl.ContentTemplate>
          <DataTemplate x:DataType="vm:ProjectItemViewModel">
            <StackPanel Spacing="18">
              <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                <StackPanel Spacing="5">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBlock Text="{Binding Name}" Classes="detailTitle"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                    <Border Grid.Column="1" Classes="phaseBadge" Classes.paused="{Binding IsPaused}"
                            Classes.ready="{Binding IsReady}" Classes.retrying="{Binding IsRetryStatus}"
                            Classes.attention="{Binding NeedsAttention}"
                            CornerRadius="10" Padding="9,3" VerticalAlignment="Center"
                            ToolTip.Tip="{Binding PhaseDetails}">
                      <TextBlock Text="{Binding Phase}" Classes="phaseText"
                                 Classes.paused="{Binding IsPaused}" Classes.ready="{Binding IsReady}"
                                 Classes.retrying="{Binding IsRetryStatus}" Classes.attention="{Binding NeedsAttention}"
                                 FontSize="11" FontWeight="SemiBold" />
                    </Border>
                  </Grid>
                  <TextBlock Text="{Binding ProjectDetailsDisplay}" Classes="muted" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding LastCheckedDisplay}" Classes="quiet" FontSize="11" />
                  <TextBlock Text="{Binding PhaseDetails}" Classes="quiet" TextWrapping="Wrap" />
                </StackPanel>
                <WrapPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left"
                           IsEnabled="{Binding AreActionsEnabled}"
                           VerticalAlignment="Center">
                  <Button Content="{Binding PauseActionLabel}" Click="TogglePause" Margin="0,0,8,8" />
                  <Button Content="Reindex" Click="ReindexProject" IsEnabled="{Binding CanReindex}"
                          ToolTip.Tip="{Binding ReindexToolTip}" Margin="0,0,8,8" />
                  <Button Content="Edit" Click="EditProject" Margin="0,0,8,8" />
                  <Button Classes="danger" Content="Remove" Click="RemoveProject" Margin="0,0,0,8" />
                </WrapPanel>
              </Grid>

              <UniformGrid Columns="5">
                <Border Classes="metricCard" Margin="0,0,9,0">
                  <StackPanel Spacing="5">
                    <TextBlock Text="SUPPORTED ROOT FILES" Classes="eyebrow" TextWrapping="Wrap" MinHeight="26" />
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Height="31" HorizontalAlignment="Left">
                      <TextBlock Text="{Binding DocumentCount, StringFormat={}{0:N0}}" Classes="metricValue"
                                 ToolTip.Tip="Unique files currently discovered across this project's folders." />
                    </Viewbox>
                  </StackPanel>
                </Border>
                <Border Classes="metricCard" Margin="0,0,9,0">
                  <StackPanel Spacing="5">
                    <TextBlock Text="UP TO DATE" Classes="eyebrow" TextWrapping="Wrap" MinHeight="26" />
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Height="31" HorizontalAlignment="Left">
                      <TextBlock Text="{Binding ReadyCount, StringFormat={}{0:N0}}" Classes="metricValue"
                                 ToolTip.Tip="Included supported root files with no pending updates or current extraction issues. This does not mean every attachment or byte is searchable." />
                    </Viewbox>
                  </StackPanel>
                </Border>
                <Border Classes="metricCard" Margin="0,0,9,0">
                  <StackPanel Spacing="5">
                    <TextBlock Text="PROCESSING" Classes="eyebrow" TextWrapping="Wrap" MinHeight="26" />
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Height="31" HorizontalAlignment="Left">
                      <TextBlock Text="{Binding ProcessingCount, StringFormat={}{0:N0}}" Classes="metricValue"
                                 ToolTip.Tip="Files currently being processed. Files waiting for processor capacity are counted in Queued." />
                    </Viewbox>
                  </StackPanel>
                </Border>
                <Border Classes="metricCard" Margin="0,0,9,0">
                  <StackPanel Spacing="5">
                    <TextBlock Text="QUEUED" Classes="eyebrow" TextWrapping="Wrap" MinHeight="26" />
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Height="31" HorizontalAlignment="Left">
                      <TextBlock Text="{Binding QueuedCount, StringFormat={}{0:N0}}" Classes="metricValue"
                                 ToolTip.Tip="Files waiting for processing, including scheduled retries. A previous indexed version may remain searchable." />
                    </Viewbox>
                    <TextBlock IsVisible="{Binding HasQueueBreakdown}"
                               Text="{Binding QueuedBreakdownDisplay}" Classes="quiet" FontSize="10" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
                <Border Classes="metricCard" Classes.hasErrors="{Binding HasAttentionFiles}">
                  <StackPanel Spacing="5">
                    <TextBlock Text="NEEDS ATTENTION" Classes="eyebrow" TextWrapping="Wrap" MinHeight="26" />
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Height="31" HorizontalAlignment="Left">
                      <TextBlock Text="{Binding AttentionCount, StringFormat={}{0:N0}}" Classes="metricValue"
                                 Classes.hasErrors="{Binding HasAttentionFiles}"
                                 ToolTip.Tip="Files with current issues and no retry queued or running. Review the issues below, then retry when the problem is fixed." />
                    </Viewbox>
                  </StackPanel>
                </Border>
              </UniformGrid>
              <TextBlock Text="{Binding SearchableSummary}"
                         Classes="quiet" FontSize="11" TextWrapping="Wrap" />
              <TextBlock Text="Counts cover included supported root files. Unsupported root formats are not counted; unsupported embedded attachments are skipped while supported content stays searchable. Up to date does not mean every byte or attachment is searchable."
                         Classes="quiet" FontSize="11" TextWrapping="Wrap" />

              <Border IsVisible="{Binding HasFolderIssues}" Classes="card semanticCoverageWarning">
                <StackPanel Spacing="9">
                  <TextBlock Text="Folder access needs attention" Classes="sectionTitle" />
                  <TextBlock Text="Some folders cannot be checked for changes. Previously indexed files remain searchable."
                             Classes="muted" TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding FolderIssues}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="indexing:ProjectFolderIssue">
                        <StackPanel Spacing="3" Margin="0,4">
                          <TextBlock Text="{Binding Path}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                     ToolTip.Tip="{Binding Path}" />
                          <TextBlock Text="{Binding Message}" Classes="quiet" TextWrapping="Wrap" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Border Classes="card" Classes.semanticCoverageWarning="{Binding HasSemanticCoverageWarning}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                  <StackPanel Spacing="6">
                    <WrapPanel Orientation="Horizontal">
                      <TextBlock Text="Meaning-based search coverage" Classes="sectionTitle" />
                      <Border Classes="statusBadge" Margin="10,2,0,0" Classes.ready="{Binding IsSemanticCoverageComplete}"
                              Classes.warning="{Binding HasSemanticCoverageWarning}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SemanticIndexStatusLabel}" Classes="statusText"
                                   Classes.ready="{Binding IsSemanticCoverageComplete}" Classes.warning="{Binding HasSemanticCoverageWarning}" />
                      </Border>
                    </WrapPanel>
                    <TextBlock Text="{Binding SemanticIndexStatusMessage}" Classes="muted"
                               TextWrapping="Wrap" MaxWidth="720" />
                  </StackPanel>
                  <Button Grid.Column="1" IsVisible="{Binding ShowSemanticRepairButton}"
                          Content="Complete search coverage" Click="RepairSemanticIndex"
                          IsEnabled="{Binding CanRepairSemanticIndex}"
                          ToolTip.Tip="{Binding RepairSemanticIndexToolTip}"
                          VerticalAlignment="Center" />
                </Grid>
              </Border>

              <Border IsVisible="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).HasActiveIndexingItems}"
                      Classes="card">
                <StackPanel Spacing="12">
                  <ToggleButton Classes="sectionToggle"
                                AutomationProperties.Name="Expand or collapse indexing activity"
                                IsChecked="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).IsActiveIndexingExpanded, Mode=TwoWay}">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                      <StackPanel Spacing="3">
                        <TextBlock Text="Indexing activity" Classes="sectionTitle" />
                        <TextBlock Text="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).IndexingTimingSummary}"
                                   Classes="quiet" FontSize="12" />
                      </StackPanel>
                      <Border Grid.Column="1" Background="{DynamicResource SuccessSubtleBrush}"
                              CornerRadius="10" Padding="9,4" VerticalAlignment="Center">
                        <TextBlock Text="LIVE" Foreground="{DynamicResource SuccessBrush}"
                                   FontSize="10" FontWeight="SemiBold" LetterSpacing="0.6" />
                      </Border>
                      <TextBlock Grid.Column="2" Text="⌃" RenderTransform="rotate(180deg)"
                                 RenderTransformOrigin="50%,50%"
                                 IsVisible="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).IsActiveIndexingCollapsed}"
                                 Classes="muted" FontSize="18" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="⌃"
                                 IsVisible="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).IsActiveIndexingExpanded}"
                                 Classes="muted" FontSize="18" VerticalAlignment="Center" />
                    </Grid>
                  </ToggleButton>
                  <ItemsControl IsVisible="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).IsActiveIndexingExpanded}"
                                ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ActiveIndexingItems}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:IndexingActivityItemViewModel">
                        <Border Classes="subtleCard" Margin="0,3">
                          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SourcePath}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="13" Margin="16,0,0,0"
                                        IsVisible="{Binding ShowTimers}">
                              <TextBlock Text="{Binding ElapsedDisplay}" Classes="muted" FontSize="12" />
                              <TextBlock Text="{Binding StageElapsedDisplay}" Classes="quiet" FontSize="12" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding SourcePath}" Classes="quiet"
                                       FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SourcePath}"
                                       Margin="0,3,0,0" />
                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding StageDisplay}"
                                       Foreground="{DynamicResource AccentBrush}" FontSize="12"
                                       FontWeight="SemiBold" Margin="0,9,0,5" />
                            <ProgressBar Grid.Row="3" Grid.ColumnSpan="2" Height="5"
                                         IsIndeterminate="{Binding IsProgressIndeterminate}"
                                         AutomationProperties.Name="File indexing activity; completion time is unknown" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Grid ColumnDefinitions="3*,2*" ColumnSpacing="18">
                <Border Classes="card">
                  <StackPanel Spacing="13">
                    <StackPanel Spacing="3">
                      <TextBlock Text="File types" Classes="sectionTitle" />
                      <TextBlock Text="Files currently included in this project." Classes="quiet" FontSize="12" />
                    </StackPanel>
                      <TextBlock IsVisible="{Binding HasNoFileTypeCounts}" Text="File-type totals are not available yet."
                               Classes="muted" TextWrapping="Wrap" />
                    <ItemsControl IsVisible="{Binding HasFileTypeCounts}" ItemsSource="{Binding FileTypeCounts}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="core:ProjectFileTypeCount">
                          <Border Classes="fileTypeChip" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding Extension}" FontWeight="SemiBold"
                                         Foreground="#C7D7F3" />
                              <Border Background="#26354B" CornerRadius="7" Padding="7,1">
                                <TextBlock Text="{Binding Count}" Classes="muted" FontSize="11" />
                              </Border>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <Border Grid.Column="1" Classes="card">
                  <StackPanel Spacing="13">
                    <StackPanel Spacing="3">
                      <TextBlock Text="Folders" Classes="sectionTitle" />
                      <TextBlock Text="Watched for changes when available." Classes="quiet" FontSize="12" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Folders}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="core:ProjectFolderInfo">
                          <Border Classes="folderRow" Margin="0,3">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                              <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource AccentBrush}"
                                      VerticalAlignment="Center" />
                              <SelectableTextBlock Grid.Column="1" Text="{Binding Path}" Classes="muted"
                                         TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}"
                                         AutomationProperties.Name="Watched folder path, selectable and copyable" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </Grid>

              <Border Classes="card issuesCard" IsVisible="{Binding HasIssueCard}">
                <StackPanel Spacing="12">
                  <ToggleButton Classes="sectionToggle" IsChecked="{Binding IsErrorsExpanded, Mode=TwoWay}"
                                Click="IssueSectionToggled" AutomationProperties.Name="Expand or collapse current issues">
                    <StackPanel Spacing="4">
                      <TextBlock Text="Current issues by root file" Classes="sectionTitle" />
                      <TextBlock Text="{Binding GroupedIssuesSummary}" Classes="quiet" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                  </ToggleButton>
                  <StackPanel IsVisible="{Binding IsErrorsExpanded}" Spacing="10">
                    <TextBlock Text="Each row is one original root file. Its attachments and pages appear in component details; actions apply to the root file."
                               Classes="quiet" FontSize="12" TextWrapping="Wrap" />
                    <TextBox Text="{Binding IssueQuery, Mode=TwoWay}" MaxLength="500" TextChanged="IssueFiltersChanged"
                             PlaceholderText="Search filename, full path, issue code or message"
                             AutomationProperties.Name="Search current issues by filename path or cause" />
                    <TextBox Text="{Binding IssueCodeFilter, Mode=TwoWay}" MaxLength="200" TextChanged="IssueFiltersChanged"
                             PlaceholderText="Optional exact cause code, e.g. access_denied"
                             AutomationProperties.Name="Filter current issues by exact cause code" />
                    <WrapPanel Orientation="Horizontal">
                      <ComboBox SelectedIndex="{Binding IssueImpactFilterIndex, Mode=TwoWay}" SelectionChanged="IssueImpactChanged"
                                MinWidth="180" Margin="0,0,8,8" AutomationProperties.Name="Filter issues by search impact">
                        <ComboBoxItem Content="All search impacts" />
                        <ComboBoxItem Content="No searchable content" />
                        <ComboBoxItem Content="Partial content" />
                        <ComboBoxItem Content="Previous evidence retained" />
                      </ComboBox>
                      <ToggleButton Content="{Binding HiddenIssuesDisplay}" IsChecked="{Binding ShowHiddenIssues, Mode=TwoWay}"
                                    Click="ShowHiddenIssues" Margin="0,0,8,8" AutomationProperties.Name="Show or hide acknowledged issues" />
                      <Button Content="Restore all hidden" Click="RestoreAllIssues" IsVisible="{Binding HasHiddenIssues}"
                              IsEnabled="{Binding AreActionsEnabled}" Margin="0,0,0,8" />
                    </WrapPanel>
                    <WrapPanel Orientation="Horizontal">
                      <Button Content="Retry visible page" Click="RetryVisibleFiles" IsEnabled="{Binding CanRetryVisibleIssueFiles}"
                              Margin="0,0,8,8" ToolTip.Tip="Only eligible, non-hidden root files on this displayed page." />
                      <Button Content="Retry all files with issues" Click="RetryFailedFiles" IsEnabled="{Binding CanRetryFailedFiles}"
                              ToolTip.Tip="Includes other pages, filters and hidden issues in this project." Margin="0,0,8,8" />
                      <Button Content="Refresh issues" Click="RefreshIssues" IsEnabled="{Binding AreActionsEnabled}" Margin="0,0,0,8" />
                    </WrapPanel>
                    <Border IsVisible="{Binding IssuesChangedDuringPaging}" Classes="folderRow">
                      <StackPanel Spacing="6">
                        <TextBlock Text="Issues changed while you were browsing. Your page position is preserved; new or changed files earlier in path order may be on a previous page."
                                   Classes="muted" FontSize="12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <Button Content="Refresh from start" Click="RefreshIssuesFromStart" HorizontalAlignment="Left" />
                      </StackPanel>
                    </Border>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                      <TextBlock Text="{Binding IssuePageDisplay}" Classes="quiet" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Content="Previous" Click="PreviousErrorPage" IsEnabled="{Binding CanPreviousIssuePage}"
                              AutomationProperties.Name="Previous root file issue page" />
                      <Button Grid.Column="2" Content="Next" Click="NextErrorPage" IsEnabled="{Binding CanNextIssuePage}"
                              AutomationProperties.Name="Next root file issue page" />
                    </Grid>
                    <Border IsVisible="{Binding HasIssueLoadError}" Classes="folderRow">
                      <StackPanel Spacing="5">
                        <TextBlock Text="Current issues could not be verified" FontWeight="SemiBold" />
                        <SelectableTextBlock Text="{Binding IssueLoadError}" TextWrapping="Wrap" Classes="muted" />
                        <Button Content="Try again" Click="RefreshIssues" HorizontalAlignment="Left" />
                      </StackPanel>
                    </Border>
                    <TextBlock IsVisible="{Binding HasNoMatchingIssueGroups}" Text="{Binding NoMatchingIssuesMessage}"
                               Classes="muted" TextWrapping="Wrap" />
                    <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  IsVisible="{Binding HasIssueGroups}" AutomationProperties.Name="Bounded root file issue list">
                      <ItemsControl ItemsSource="{Binding IssueGroups}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ProjectIssueGroupViewModel">
                            <Border Classes="folderRow" Margin="0,0,0,10">
                              <StackPanel Spacing="7">
                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <SelectableTextBlock Text="{Binding SourcePath}" Classes="quiet" FontSize="12" TextWrapping="Wrap"
                                                     AutomationProperties.Name="Exact original root source path, selectable and copyable" />
                                <TextBlock Text="{Binding IssueCountDisplay}" Classes="quiet" FontSize="12" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ImpactLabel}" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ImpactMessage}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding RecoveryGuidance}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding RetryLabel}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding RetryMessage}" Classes="quiet" FontSize="12" TextWrapping="Wrap" />
                                <WrapPanel Orientation="Horizontal" IsEnabled="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).CanRunProjectAction}">
                                  <Button Content="Retry file" Click="RetryIssueFile" IsEnabled="{Binding CanRetry}" Margin="0,0,7,7" />
                                  <Button Content="Hide current issues" Click="HideIssueFile" IsVisible="{Binding CanHide}" Margin="0,0,7,7"
                                          ToolTip.Tip="Acknowledge current issues only. Discovery, indexing, automatic retries and search are unchanged." />
                                  <Button Content="Restore hidden issues" Click="RestoreIssueFile" IsVisible="{Binding HasHiddenIssues}" Margin="0,0,7,7" />
                                  <Button Content="Exclude root file…" Click="ExcludeIssueFile" IsVisible="{Binding IsRootFile}" Margin="0,0,0,7"
                                          ToolTip.Tip="Separate from Hide: remove this exact project/path from indexing and search. Original file is untouched." />
                                </WrapPanel>
                                <Expander Header="Component details and exact locations" IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                  <StackPanel Spacing="8">
                                    <TextBlock IsVisible="{Binding DetailsWereRefreshed}" Text="Component issues changed; details were refreshed from the first page."
                                               Classes="quiet" FontSize="11" TextWrapping="Wrap" />
                                    <TextBlock Text="Component locators distinguish attachments with the same name. Select text to copy paths, codes or messages."
                                               Classes="quiet" FontSize="11" TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="7">
                                      <TextBlock Text="{Binding DetailsPageDisplay}" Classes="quiet" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
                                      <Button Grid.Column="1" Content="Previous" Click="PreviousIssueDetails" IsEnabled="{Binding CanPreviousDetails}" />
                                      <Button Grid.Column="2" Content="Next" Click="NextIssueDetails" IsEnabled="{Binding CanNextDetails}" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Details}">
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ProjectIssueDetailViewModel">
                                          <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,9,0,3">
                                            <StackPanel Spacing="4">
                                              <SelectableTextBlock Text="{Binding ComponentName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                              <SelectableTextBlock Text="{Binding ComponentKey}" Classes="quiet" FontSize="11" TextWrapping="Wrap"
                                                                   AutomationProperties.Name="Exact attachment page or component locator" />
                                              <SelectableTextBlock Text="{Binding Message}" Classes="muted" TextWrapping="Wrap" />
                                              <SelectableTextBlock Text="{Binding Code}" Classes="quiet" FontSize="11" TextWrapping="Wrap" />
                                              <TextBlock Text="{Binding AttemptDisplay}" Classes="quiet" FontSize="11" />
                                              <TextBlock Text="Hidden acknowledgement" IsVisible="{Binding IsHidden}" Classes="quiet" FontSize="11" />
                                              <TextBlock Text="{Binding CreatedDisplay}" Classes="quiet" FontSize="11" TextWrapping="Wrap" />
                                            </StackPanel>
                                          </Border>
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="7">
                                      <TextBlock Text="{Binding DetailsPageDisplay}" Classes="quiet" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
                                      <Button Grid.Column="1" Content="Previous" Click="PreviousIssueDetails" IsEnabled="{Binding CanPreviousDetails}" />
                                      <Button Grid.Column="2" Content="Next" Click="NextIssueDetails" IsEnabled="{Binding CanNextDetails}" />
                                    </Grid>
                                  </StackPanel>
                                </Expander>
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                      <TextBlock Text="{Binding IssuePageDisplay}" Classes="quiet" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Content="Previous" Click="PreviousErrorPage" IsEnabled="{Binding CanPreviousIssuePage}" />
                      <Button Grid.Column="2" Content="Next" Click="NextErrorPage" IsEnabled="{Binding CanNextIssuePage}" />
                    </Grid>
                    <WrapPanel Orientation="Horizontal">
                      <Button Content="Retry visible page" Click="RetryVisibleFiles" IsEnabled="{Binding CanRetryVisibleIssueFiles}" Margin="0,0,8,8" />
                      <Button Content="Retry all files with issues" Click="RetryFailedFiles" IsEnabled="{Binding CanRetryFailedFiles}" Margin="0,0,8,8" />
                      <ToggleButton Content="{Binding HiddenIssuesDisplay}" IsChecked="{Binding ShowHiddenIssues, Mode=TwoWay}"
                                    Click="ShowHiddenIssues" Margin="0,0,8,8" />
                      <Button Content="Issues changed · Refresh from start" IsVisible="{Binding IssuesChangedDuringPaging}"
                              Click="RefreshIssuesFromStart" Margin="0,0,0,8" />
                    </WrapPanel>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Classes="card" IsVisible="{Binding HasIssueActionMessage}">
                <StackPanel Spacing="8">
                  <TextBlock Text="{Binding IssueActionMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                  <Button Content="Undo last hide" Click="UndoIssueHide" IsVisible="{Binding HasUndoIssueHide}"
                          IsEnabled="{Binding AreActionsEnabled}" HorizontalAlignment="Left" />
                </StackPanel>
              </Border>

              <Border Classes="card" IsVisible="{Binding HasExcludedFiles}">
                <StackPanel Spacing="10">
                  <TextBlock Text="Excluded from indexing and search" Classes="sectionTitle" />
                  <TextBlock Text="{Binding ExcludedFilesSummary}" Classes="quiet" FontSize="12" TextWrapping="Wrap" />
                  <TextBox Text="{Binding ExcludedQuery, Mode=TwoWay}" MaxLength="500" PlaceholderText="Find an excluded path"
                           AutomationProperties.Name="Search excluded root paths" />
                  <TextBlock IsVisible="{Binding HasNoMatchingExcludedFiles}" Text="No excluded paths match this search." Classes="muted" />
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Text="{Binding ExcludedPageDisplay}" Classes="quiet" FontSize="12" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Content="Previous" Click="PreviousExcludedPage" IsEnabled="{Binding CanPreviousExcludedPage}" />
                    <Button Grid.Column="2" Content="Next" Click="NextExcludedPage" IsEnabled="{Binding CanNextExcludedPage}" />
                  </Grid>
                  <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding ExcludedFiles}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ExcludedFileItemViewModel">
                          <Border Classes="folderRow" Margin="0,0,0,7">
                            <StackPanel Spacing="6">
                              <SelectableTextBlock Text="{Binding SourcePath}" TextWrapping="Wrap" FontSize="12" />
                              <TextBlock Text="{Binding ExcludedDisplay}" Classes="quiet" FontSize="11" />
                              <TextBlock Text="{Binding ScopeDisplay}" Classes="quiet" FontSize="12" TextWrapping="Wrap" />
                              <Button Content="Include and reindex" Click="IncludeIssueFile" HorizontalAlignment="Left"
                                      IsEnabled="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).CanRunProjectAction}" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Text="{Binding ExcludedPageDisplay}" Classes="quiet" FontSize="12" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Content="Previous" Click="PreviousExcludedPage" IsEnabled="{Binding CanPreviousExcludedPage}" />
                    <Button Grid.Column="2" Content="Next" Click="NextExcludedPage" IsEnabled="{Binding CanNextExcludedPage}" />
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>
    </StackPanel>
  </ScrollViewer>

  <UserControl.Styles>
    <Style Selector="Button.addProjectButton">
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.addProjectButton:pointerover">
      <Setter Property="Background" Value="#20395F" />
      <Setter Property="BorderBrush" Value="#31568C" />
    </Style>
    <Style Selector="Button.addProjectButton:pressed">
      <Setter Property="Background" Value="#294775" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.metricCard">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="MinHeight" Value="86" />
    </Style>
    <Style Selector="Border.metricCard.hasErrors">
      <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}" />
      <Setter Property="BorderBrush" Value="#50303B" />
    </Style>
    <Style Selector="TextBlock.metricValue">
      <Setter Property="FontSize" Value="25" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.metricValue.hasErrors">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="Border.fileTypeChip">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="10,7" />
    </Style>
    <Style Selector="Border.folderRow">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="Border.errorRow">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="0,13,14,13" />
    </Style>
    <Style Selector="Border.semanticCoverageWarning">
      <Setter Property="Background" Value="{DynamicResource WarningSubtleBrush}" />
      <Setter Property="BorderBrush" Value="#5C4A2D" />
    </Style>
  </UserControl.Styles>
</UserControl>
