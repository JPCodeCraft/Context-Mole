<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ContextMole.App.UI.Views.ProjectEditorWindow"
        Width="680" Height="540" MinWidth="600" MinHeight="500"
        WindowStartupLocation="CenterOwner" Title="Project"
        Icon="/Assets/context-mole.ico">
  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="26">
    <StackPanel Spacing="5" Margin="0,0,0,18">
      <TextBlock x:Name="EditorTitle" Text="Add project" Classes="pageTitle" />
      <TextBlock Text="Name the project and choose the folders your assistant should be able to search."
                 Classes="muted" TextWrapping="Wrap" />
    </StackPanel>

    <Border x:Name="EditorForm" Grid.Row="1" Classes="card">
      <Grid RowDefinitions="Auto,Auto,Auto,*">
        <TextBlock Text="Name" Classes="fieldLabel" />
        <TextBox x:Name="ProjectNameBox" Grid.Row="1" Margin="0,7,0,18"
                 PlaceholderText="e.g. Client research" TextChanged="ProjectNameChanged"
                 AutomationProperties.Name="Project name" AutomationProperties.HelpText="Use 1 to 120 characters." />

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
          <StackPanel Spacing="2">
            <TextBlock Text="Folders" Classes="fieldLabel" />
            <TextBlock Text="Subfolders are included. Original files are never changed."
                       TextWrapping="Wrap" Classes="quiet" FontSize="12" />
          </StackPanel>
          <Button Grid.Column="1" Classes="compact" Content="Add folders" Click="AddFolders" Margin="8,0" />
          <Button x:Name="RemoveFolderButton" Grid.Column="2" Classes="ghost compact"
                  Content="Remove" Click="RemoveFolder" IsEnabled="False" />
        </Grid>

        <Panel Grid.Row="3">
          <ListBox x:Name="FoldersList" Classes="folderPicker"
                   AutomationProperties.Name="Folders to index"
                   SelectionChanged="FolderSelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding}" TextTrimming="PathSegmentEllipsis" ToolTip.Tip="{Binding}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="NoFoldersHint" Text="No folders yet. Choose Add folders to pick one or more."
                     Classes="quiet" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
        </Panel>
      </Grid>
    </Border>

    <TextBlock x:Name="ValidationBlock" Grid.Row="2" Foreground="{DynamicResource DangerBrush}"
               TextWrapping="Wrap" MinHeight="24" Margin="4,12,4,4"
               AutomationProperties.LiveSetting="Assertive" />

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="CancelButton" Classes="ghost" Content="Cancel" Click="Cancel" IsCancel="True" />
      <Button x:Name="SaveButton" Classes="primary" Content="Add project" Click="Save" IsDefault="True" />
    </StackPanel>
  </Grid>

  <Window.Styles>
    <Style Selector="ListBox.folderPicker">
      <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="5" />
    </Style>
    <Style Selector="ListBox.folderPicker ListBoxItem">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
  </Window.Styles>
</Window>
