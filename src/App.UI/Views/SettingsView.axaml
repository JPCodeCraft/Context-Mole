<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ContextMole.App.UI.ViewModels"
             x:Class="ContextMole.App.UI.Views.SettingsView"
             x:DataType="vm:MainViewModel">
  <ScrollViewer>
    <StackPanel Classes="pageContent">
      <Border Classes="card">
        <StackPanel Spacing="14">
          <StackPanel Spacing="7">
            <WrapPanel Orientation="Horizontal">
              <TextBlock Text="Application updates" Classes="sectionTitle" />
              <Border Classes="statusBadge" Classes.ready="{Binding IsApplicationUpdateReadyStatus}"
                      Classes.warning="{Binding IsApplicationUpdateWarningStatus}" VerticalAlignment="Center" Margin="9,0,0,0">
                <TextBlock Text="{Binding ApplicationUpdateStatusLabel}" Classes="statusText"
                           Classes.ready="{Binding IsApplicationUpdateReadyStatus}"
                           Classes.warning="{Binding IsApplicationUpdateWarningStatus}" />
              </Border>
            </WrapPanel>
            <TextBlock Text="{Binding ApplicationVersionLabel}" Classes="quiet" FontSize="12"
                       TextWrapping="Wrap" AutomationProperties.Name="Application version" />
            <TextBlock Text="{Binding ApplicationUpdateMessage}" Classes="muted" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ApplicationUpdateLastCheckedLabel}" Classes="quiet" FontSize="12" TextWrapping="Wrap" />
            <ProgressBar IsVisible="{Binding IsApplicationUpdateProgressVisible}"
                         Minimum="0" Maximum="100" Value="{Binding ApplicationUpdate.ProgressPercent}"
                         Height="6" Margin="0,5,0,0"
                         AutomationProperties.Name="Application update download progress" />
          </StackPanel>
          <WrapPanel>
            <Button Content="{Binding ApplicationUpdateRetryLabel}" IsVisible="{Binding CanCheckApplicationUpdates}"
                    Click="CheckApplicationUpdates" Margin="0,0,8,0" />
            <Button Content="Release notes and downloads" Click="OpenReleaseNotes" Margin="0,0,8,0" />
          <Button Classes="primary" Content="Restart to update"
                  IsVisible="{Binding IsApplicationUpdateReady}"
                  IsEnabled="{Binding CanRestartForUpdate}"
                  Click="RestartToUpdate" VerticalAlignment="Center" HorizontalAlignment="Left" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <ToggleButton Classes="sectionToggle"
                        AutomationProperties.Name="Expand or collapse AI configurations"
                        IsChecked="{Binding IsAiConnectionsExpanded, Mode=TwoWay}">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
              <TextBlock Text="AI connections" Classes="sectionTitle" VerticalAlignment="Center" HorizontalAlignment="Left" />
              <Border Grid.Column="1" Classes="statusBadge" Classes.ready="{Binding AreAiConnectionsReady}"
                      Classes.warning="{Binding DoAiConnectionsNeedAttention}" VerticalAlignment="Center">
                <TextBlock Text="{Binding AiConnectionsStatusLabel}" Classes="statusText"
                           Classes.ready="{Binding AreAiConnectionsReady}"
                           Classes.warning="{Binding DoAiConnectionsNeedAttention}" />
              </Border>
              <TextBlock Grid.Column="2" Text="⌃" RenderTransform="rotate(180deg)"
                         RenderTransformOrigin="50%,50%" IsVisible="{Binding IsAiConnectionsCollapsed}"
                         Classes="muted" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Left" />
              <TextBlock Grid.Column="2" Text="⌃" IsVisible="{Binding IsAiConnectionsExpanded}"
                         Classes="muted" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Left" />
            </Grid>
          </ToggleButton>
          <Button Content="Check again" Click="CheckAiConnections" IsEnabled="{Binding CanCheckAiConnections}"
                  HorizontalAlignment="Left" ToolTip.Tip="Read current AI configuration without changing it."
                  AutomationProperties.Name="Check AI configurations again without changing them" />
          <StackPanel IsVisible="{Binding IsAiConnectionsExpanded}" Spacing="4">
            <TextBlock Text="Indexing, OCR, and search run locally. Configured AI tools can read project names, folder paths, and indexed passages across all your projects. An AI tool may send returned content to its provider according to its settings. Context Mole’s tools are read-only and do not change your source files. This does not keep returned excerpts private from that AI tool or its provider."
                       Classes="muted" TextWrapping="Wrap" Margin="0,0,0,10" />

            <CheckBox Content="Show clients unavailable on this platform" IsChecked="{Binding ShowAllAiClients, Mode=TwoWay}" />
            <ItemsControl ItemsSource="{Binding VisibleAiConnections}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AiConnectionItemViewModel">
                  <Border Classes="settingsRow" Margin="0,4">
                    <StackPanel Spacing="12">
                      <StackPanel Spacing="5">
                        <WrapPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding DisplayName}" Classes="cardTitle" />
                          <Border Classes="statusBadge" Classes.ready="{Binding IsReadyStatus}"
                                  Classes.warning="{Binding IsWarningStatus}" Classes.danger="{Binding IsErrorStatus}"
                                  VerticalAlignment="Center" Margin="9,0,0,0">
                            <TextBlock Text="{Binding StatusLabel}" Classes="statusText"
                                       Classes.ready="{Binding IsReadyStatus}"
                                       Classes.warning="{Binding IsWarningStatus}"
                                       Classes.danger="{Binding IsErrorStatus}" />
                          </Border>
                        </WrapPanel>
                        <TextBlock Text="{Binding Description}" Classes="quiet" FontSize="12" TextWrapping="Wrap" />
                        <TextBlock IsVisible="{Binding HasDetailMessage}" Text="{Binding Message}"
                                   Classes="muted" TextWrapping="Wrap" />
                        <SelectableTextBlock IsVisible="{Binding HasConfigPath}" Text="{Binding ConfigPath}"
                                             TextWrapping="Wrap" FontSize="12"
                                             AutomationProperties.Name="AI configuration file path" />
                        <Button IsVisible="{Binding HasConfigPath}" Content="Copy configuration path"
                                CommandParameter="{Binding}" Click="CopyConfigurationPath" HorizontalAlignment="Left" />
                      </StackPanel>
                      <Button Content="{Binding ActionLabel}"
                              IsVisible="{Binding CanShowAutomaticSetupAction}"
                              IsEnabled="{Binding CanChange}"
                              CommandParameter="{Binding}"
                              Click="ToggleAiConnection"
                              VerticalAlignment="Center" HorizontalAlignment="Left" />
                      <Button Content="Open setup guide"
                              IsVisible="{Binding RequiresManualSetup}"
                              Click="OpenManualSetupGuide"
                              VerticalAlignment="Center" HorizontalAlignment="Left" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="4">
          <TextBlock Text="Local search features" Classes="sectionTitle" />
          <TextBlock Text="Optional local features used while indexing and searching."
                     Classes="muted" TextWrapping="Wrap" Margin="0,0,0,10" />

          <Border Classes="settingsRow">
            <StackPanel Spacing="12">
              <StackPanel Spacing="5">
                <WrapPanel Orientation="Horizontal">
                  <TextBlock Text="Document OCR" Classes="cardTitle" />
                  <Border Classes="statusBadge" Classes.ready="{Binding IsOcrReadyStatus}"
                          Classes.warning="{Binding IsOcrWarningStatus}" VerticalAlignment="Center" Margin="9,0,0,0">
                    <TextBlock Text="{Binding OcrStatusLabel}" Classes="statusText"
                               Classes.ready="{Binding IsOcrReadyStatus}"
                               Classes.warning="{Binding IsOcrWarningStatus}" />
                  </Border>
                </WrapPanel>
                <TextBlock Text="{Binding OcrStatusMessage}" Classes="muted" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="{Binding OcrFeatureImpact}" Classes="quiet" FontSize="12" TextWrapping="Wrap" />
                <ProgressBar IsVisible="{Binding IsOcrProgressVisible}" Minimum="0" Maximum="100"
                             Value="{Binding OcrProgressPercent}" IsIndeterminate="{Binding IsOcrProgressIndeterminate}"
                             AutomationProperties.Name="Current OCR file download or verification progress" Height="7" />
              </StackPanel>
              <Button IsVisible="{Binding CanCancelOcrSetup}" Content="Cancel this setup attempt"
                      Click="CancelOcrSetup" HorizontalAlignment="Left" />
              <Button IsVisible="{Binding CanRetryOcrSetup}" Content="Retry OCR setup"
                      Click="RetryOcrSetup" VerticalAlignment="Center" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>

          <Border Classes="settingsRow" Margin="0,8,0,0">
            <StackPanel Spacing="16">
              <StackPanel Spacing="5">
                <WrapPanel Orientation="Horizontal">
                  <TextBlock Text="Semantic search" Classes="cardTitle" />
                  <Border Classes="statusBadge" Classes.ready="{Binding IsSemanticSearchReadyStatus}"
                          Classes.warning="{Binding IsSemanticSearchWarningStatus}"
                          Classes.danger="{Binding IsSemanticSearchErrorStatus}" VerticalAlignment="Center" Margin="9,0,0,0">
                    <TextBlock Text="{Binding SemanticSearchStatusLabel}" Classes="statusText"
                               Classes.ready="{Binding IsSemanticSearchReadyStatus}"
                               Classes.warning="{Binding IsSemanticSearchWarningStatus}"
                               Classes.danger="{Binding IsSemanticSearchErrorStatus}" />
                  </Border>
                </WrapPanel>
                <TextBlock Text="{Binding SemanticSearchStatusMessage}" Classes="muted" TextWrapping="Wrap" />
                <TextBlock Text="{Binding EmbeddingModelSummary}" Classes="quiet" FontSize="12"
                           TextWrapping="Wrap" Margin="0,3,0,0" />
              </StackPanel>
              <StackPanel Spacing="7" VerticalAlignment="Center">
                <TextBlock Text="EMBEDDING MODEL" Classes="eyebrow" />
                <TextBlock Text="{Binding SelectedEmbeddingModel.DisplayName}"
                           TextWrapping="Wrap" AutomationProperties.Name="Embedding model" />
                <TextBlock Text="Existing semantic indexes rebuild safely when the model is ready. Keyword search and literal reads remain available. Older document preparation requires Reindex with source folders available."
                           Classes="quiet" FontSize="12" TextWrapping="Wrap" />
                <Button IsVisible="{Binding IsSemanticSearchSetupVisible}"
                        IsEnabled="{Binding CanSetUpSemanticSearch}"
                        Classes="primary" Content="{Binding SemanticSearchSetupButtonLabel}"
                        Click="SetupSemanticSearch" HorizontalAlignment="Left" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="14">
          <StackPanel Spacing="7">
            <TextBlock Text="Performance" Classes="sectionTitle" />
            <TextBlock Text="Choose how much processing power Context Mole may use for background work."
                       Classes="muted" TextWrapping="Wrap" />
            <TextBlock Text="{Binding CpuUsageSummary}" Foreground="{DynamicResource AccentBrush}"
                       FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Spacing="7" VerticalAlignment="Center">
            <TextBlock Text="CPU USAGE PROFILE" Classes="eyebrow" />
            <ComboBox ItemsSource="{Binding CpuUsageProfiles}"
                      SelectedItem="{Binding SelectedCpuUsageProfile, Mode=OneWay}"
                      SelectionChanged="CpuUsageProfileChanged"
                      AutomationProperties.Name="CPU usage profile" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding IsWindowsStartupSupported}">
        <StackPanel Spacing="14">
          <StackPanel Spacing="6">
            <TextBlock Text="Start with Windows" Classes="sectionTitle" />
            <TextBlock Text="Keep the local index available after you sign in. The app starts in the background and remains accessible from the system tray."
                       Classes="muted" TextWrapping="Wrap" />
          </StackPanel>
          <CheckBox                     IsChecked="{Binding StartWithWindowsEnabled, Mode=OneWay}"
                    Content="Launch automatically" Click="StartWithWindowsChanged"
                    VerticalAlignment="Center" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding IsWindowsUninstallVisible}">
        <StackPanel Spacing="14">
          <StackPanel Spacing="6">
            <TextBlock Text="Uninstall Context Mole" Classes="sectionTitle" />
            <TextBlock Text="{Binding WindowsUninstallMessage}"
                       Classes="muted" TextWrapping="Wrap" />
          </StackPanel>
          <Button Classes="danger" Content="Uninstall Context Mole…"
                  IsEnabled="{Binding CanUninstallFromSettings}"
                  Click="UninstallContextMole" VerticalAlignment="Center" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>

  <UserControl.Styles>
    <Style Selector="Border.settingsRow">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="15" />
    </Style>
  </UserControl.Styles>
</UserControl>
