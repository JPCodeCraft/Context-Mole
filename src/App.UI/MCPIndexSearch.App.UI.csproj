<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\MCPIndexSearch.Core.csproj" />
    <ProjectReference Include="..\Indexing\MCPIndexSearch.Indexing.csproj" />
    <ProjectReference Include="..\Documents\MCPIndexSearch.Documents.csproj" />
    <ProjectReference Include="..\Search\MCPIndexSearch.Search.csproj" />
    <ProjectReference Include="..\Storage\MCPIndexSearch.Storage.csproj" />
    <ProjectReference Include="..\Infrastructure\MCPIndexSearch.Infrastructure.csproj" />
    <ProjectReference Include="..\Mcp\MCPIndexSearch.Mcp.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <Target Name="PublishBundledMcpServer" AfterTargets="Publish"
          Condition="'$(RuntimeIdentifier)' != '' and '$(MCPIndexSearchSkipMcpBundle)' != 'true'">
    <PropertyGroup>
      <_McpBundleDirectory>$(PublishDir)mcp-server\</_McpBundleDirectory>
    </PropertyGroup>
    <MSBuild Projects="..\Mcp\MCPIndexSearch.Mcp.csproj" Targets="Publish" BuildInParallel="false"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishSingleFile=false;PublishTrimmed=false;PublishAot=false;PublishDir=$(_McpBundleDirectory);MCPIndexSearchSkipMcpBundle=true" />
  </Target>
</Project>
